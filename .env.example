# BBVS Environment Variables
# Copy this file to .env.local and update the values as needed

# API Configuration
BBVS_API_URL=http://localhost:4001

# Compiler Service URL
COMPILER_URL=http://localhost:4000

# Blockchain Service URL
BLOCKCHAIN_URL=http://localhost:4005

# Host URL for the application
HOST_URL=http://localhost:3000

# Smart Contract Address for Elections
ELECTION_CONTRACT_ADDRESS=

# Node Environment (development, production, test)
# This is automatically set by Next.js, but you can override it
NODE_ENV=development
